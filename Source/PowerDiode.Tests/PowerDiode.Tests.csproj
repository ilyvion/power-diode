<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <UseLaboratory>true</UseLaboratory>
        <RootNamespace>PowerDiode.Tests</RootNamespace>
        <AssemblyName>PowerDiode.Tests</AssemblyName>
    </PropertyGroup>
    <!--
        Dev-only test assembly, run in-game via DevTools
        (https://github.com/ilyvion/SmashPhil-DevTools). It builds into the same
        <version>/Assemblies folder as the mod assembly, next to the DevTools.dll that the
        DevTools reference below also builds into that folder.

        It's listed in PowerDiode.sln so it always builds locally (default Configuration is
        Debug, see .vscode/build_config.sh), but PowerDiode.sln deliberately omits a
        Release|Any CPU.Build.0 line for this project's GUID, so a Release-configuration build
        (what CI/release always use, per rimworld-utils' build_mod.yml) skips building it, and
        DevTools, entirely; neither DLL lands in a shipped release.
    -->
    <!--
        Without the DevTools reference (see below), this project has no Publicize items of its
        own, so Krafs.Publicizer's generated IgnoresAccessChecksToAttribute merely shadows the
        one already made public inside the referenced PowerDiode assembly; CS0436 is harmless
        here.
    -->
    <PropertyGroup Condition="'$(RimWorldVersion)' != '1.6'">
        <NoWarn>$(NoWarn);CS0436</NoWarn>
    </PropertyGroup>
    <ItemGroup>
        <ProjectReference Include="..\PowerDiode\PowerDiode.csproj">
            <CopyLocal>False</CopyLocal>
            <Private>false</Private>
        </ProjectReference>
    </ItemGroup>
    <!--
        DevTools only supports RimWorld 1.6, so for any other RimWorldVersion this project builds
        as an empty assembly: both the test sources and the DevTools reference are excluded
        below. DevTools' own OutDir is relative to its clone location, so it's redirected to this
        mod's 1.6/Assemblies folder.
    -->
    <ItemGroup Condition="'$(RimWorldVersion)' == '1.6'">
        <ProjectReference
            Include="$(ProjectDependenciesBasePath)\Third-Party\DevTools\DevTools\DevTools.csproj"
            AdditionalProperties="OutDir=$(MSBuildThisFileDirectory)..\..\1.6\Assemblies\"
        >
            <CopyLocal>False</CopyLocal>
            <Private>false</Private>
        </ProjectReference>
        <Publicize Include="Assembly-CSharp:Verse.FloatMenu.options" />
    </ItemGroup>
    <ItemGroup Condition="'$(RimWorldVersion)' != '1.6'">
        <Compile Remove="**/*.cs" />
    </ItemGroup>
</Project>
